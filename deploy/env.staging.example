# Staging environment. Copy to the secret manager or .env.staging; do not commit it.
ENGRAM_STAGING_API_KEY=
ENGRAM_STAGING_ADMIN_KEY=
ENGRAM_STAGING_DATABASE_URL=postgresql://engram_staging_app:REPLACE_ME@postgres:5432/engram_staging
ENGRAM_STAGING_NEO4J_URI=bolt://neo4j-staging:7687
ENGRAM_STAGING_NEO4J_PASSWORD=
ENGRAM_STAGING_REDIS_URL=redis://redis-staging:6379
ENGRAM_STAGING_TEMPORAL_ADDRESS=temporal-staging:7233
OPENCODE_GO_API_KEY=

# Token-only compaction; restart API/workers after changing these values.
ENGRAM_SESSION_COMPACTION_TRIGGER_TOKENS=64000
ENGRAM_SESSION_COMPACTION_TARGET_RATIO=0.5
ENGRAM_SESSION_COMPACTION_INPUT_TOKENS=64000
ENGRAM_SESSION_COMPACTION_SUMMARY_TOKENS=2000
ENGRAM_RETRIEVAL_QUALITY_MODE=enforce
