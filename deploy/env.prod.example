# Copy to .env.prod at the repository root, set mode 0600, and replace every
# value. Do not commit the resulting .env.prod file.
ENGRAM_API_KEY=
ENGRAM_ADMIN_KEY=
ENGRAM_SECRET_KEY=
OPENCODE_GO_API_KEY=
NEO4J_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
ENGRAM_DB_PASSWORD=
ENGRAM_DATABASE_URL=postgresql://engram_app:REPLACE_ME@postgres:5432/engram
ENGRAM_IMAGE_TAG=0.1.0
TEMPORAL_SERVER_VERSION=1.30.4.1
TEMPORAL_ADMIN_VERSION=1.30.6
# Host-published API, Temporal UI, Prometheus, and Grafana bind to loopback
# unless this is deliberately changed. Prefer the TLS nginx profile for LAN.
ENGRAM_BIND_ADDRESS=127.0.0.1

# Token-only compaction; restart API/workers after changing these values.
ENGRAM_SESSION_COMPACTION_TRIGGER_TOKENS=64000
ENGRAM_SESSION_COMPACTION_TARGET_RATIO=0.5
ENGRAM_SESSION_COMPACTION_INPUT_TOKENS=64000
ENGRAM_SESSION_COMPACTION_SUMMARY_TOKENS=2000
ENGRAM_RETRIEVAL_QUALITY_MODE=enforce
