# Engram Phase 1 - required secrets
ENGRAM_API_KEY=change-me-before-exposing-this-port
ENGRAM_ADMIN_KEY=change-me-admin-key

# Stable admin UI session signing key. Use a long random value in real envs.
ENGRAM_SECRET_KEY=change-me-session-secret

# Muse Spark inference through the OpenCode Go Responses API
OPENCODE_GO_API_KEY=change-me-opencode-go-key

# Neo4j admin password (Community Edition uses a single user).
# §12.3 writer/reader RBAC is deferred to Phase 2 / Enterprise.
NEO4J_ADMIN_PASSWORD=engram-admin

# Required PostgreSQL control-plane connection.
ENGRAM_DB_PASSWORD=change-me-application-password
ENGRAM_DATABASE_URL=postgresql://engram_app:change-me-application-password@localhost:5432/engram
# The same DSN and ENGRAM_DB_PASSWORD are used by API, migrations,
# dispatcher, Temporal schema setup, and Temporal server roles.

# Optional overrides
ENGRAM_CONFIG_PATH=./config.yaml
ENGRAM_DATA_DIR=./data/mem

# Token-only compaction; restart API/workers after changing these values.
ENGRAM_SESSION_COMPACTION_TRIGGER_TOKENS=64000
ENGRAM_SESSION_COMPACTION_TARGET_RATIO=0.5
ENGRAM_SESSION_COMPACTION_INPUT_TOKENS=64000
ENGRAM_SESSION_COMPACTION_SUMMARY_TOKENS=2000
ENGRAM_RETRIEVAL_QUALITY_MODE=enforce
